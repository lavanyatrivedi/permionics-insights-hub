# ─── Permionics BD Suite — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored — it will NEVER be pushed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# ADMIN_PASSWORD: the shared login password for your team portal
ADMIN_PASSWORD=your-team-password-here

# SESSION_SECRET: any long random string (32+ chars), used to sign JWT cookies
# Generate one: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Server (optional locally, auto-set on Railway/Render) ────────────────────
PORT=8080
